@model List<CartItem>
@{
    ViewData["Title"] = "Sepetim";
}

<h1>Sepetim</h1>

@if (!Model.Any())
{
    <div class="card">
        <p>Sepetiniz boş.</p>
        <a class="btn" asp-controller="Products" asp-action="Index">Alışverişe Başla</a>
    </div>
}
else
{
    <table class="sepet-tablo">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>Fiyat</th>
                <th>Adet</th>
                <th>Ara Toplam</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="urun-hucre">
                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                        @item.ProductName
                    </td>
                    <td>@item.Price.ToString("C2")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="miktar-form">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="miktar-input" onchange="this.form.submit()" />
                        </form>
                    </td>
                    <td>@item.Toplam.ToString("C2")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn-sil">Kaldır</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="sepet-ozet">
        <h2>Genel Toplam: @Model.Sum(x => x.Toplam).ToString("C2")</h2>
        <a class="btn" asp-controller="Cart" asp-action="Checkout">Siparişi Onayla</a>
    </div>
}
